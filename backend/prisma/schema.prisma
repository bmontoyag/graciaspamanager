generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Configuration {
  id                        Int      @id @default(autoincrement())
  primaryColor              String?
  backgroundColor           String?
  sidebarColor              String?
  themeMode                 String?
  logoUrl                   String?
  loginBgUrl                String?
  openTime                  String   @default("09:00")
  closeTime                 String   @default("21:00")
  appointmentBuffer         Int      @default(10)
  backupEnabled             Boolean  @default(false)
  backupFrequency           String   @default("daily")
  backupTime                String   @default("02:00")
  backupEmail               String?
  notificationsEnabled      Boolean  @default(true)
  notifyNewAppointment      Boolean  @default(true)
  notifyAppointmentReminder Boolean  @default(true)
  notifyDailySummary        Boolean  @default(false)
  notifyPaymentReceived     Boolean  @default(false)
  notifyCancellation        Boolean  @default(true)
  reminderMinutesBefore     Int      @default(60)
  dailySummaryTime          String   @default("08:00")
  birthdayMessage           String   @default("¡Hola {name}! 🎉 De parte de todo el equipo de Gracia Spa queremos desearte un muy feliz cumpleaños. 🎂 Tenemos una promoción especial para ti por tu día, ¡escríbenos para agendarla! 💆‍♀️✨")
  whatsappMessageTemplate   String   @default("Hola {name}, tu reserva para {service} el {date} a las {time} está confirmada.")
  discoverySources          String[] @default(["Facebook", "Instagram", "TikTok", "Referencia", "Google Maps"])
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  loyaltyPointsToRedeem     Int      @default(10)
  facebookUrl               String?
  instagramUrl              String?
  tiktokUrl                 String?
  whatsappUrl               String?
  marketingMessage          String?  @default("¡Descubre nuestras promociones especiales! ✨")
  businessName              String   @default("Gracia Spa")
  businessRuc               String?
  businessAddress           String?
  businessPhone             String?
  businessEmail             String?
  igvRate                   Decimal  @default(18) @db.Decimal(5, 2)
}

model BlockedSlot {
  id        Int      @id @default(autoincrement())
  date      DateTime
  startTime String
  endTime   String
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                   Int                    @id @default(autoincrement())
  email                String                 @unique
  passwordHash         String
  name                 String
  phoneNumber          String?
  fingerprintKey       String?
  isActive             Boolean                @default(true)
  pushToken            String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  commissionPercentage Decimal                @default(50.0) @db.Decimal(5, 2)
  appointmentsWorker   Appointment[]          @relation("WorkerAppointments")
  appointmentWorkers   AppointmentWorker[]
  attentions           AttentionWorker[]
  auditLogs            AuditLog[]             @relation("UserAuditLogs")
  expenses             Expense[]              @relation("WorkerExpenses")
  notificationTasks    NotificationTask[]     @relation("UserNotificationTasks")
  roles                UserRole[]
  corporateDays        CorporateEventWorker[]
  corporateQuotes      CorporateQuote[]       @relation("QuoteCreatedBy")
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  modules     RoleModule[]
  users       UserRole[]
}

model Module {
  id        Int          @id @default(autoincrement())
  key       String       @unique
  name      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  roles     RoleModule[]
}

model RoleModule {
  roleId   Int
  moduleId Int
  module   Module @relation(fields: [moduleId], references: [id])
  role     Role   @relation(fields: [roleId], references: [id])

  @@id([roleId, moduleId])
}

model UserRole {
  userId Int
  roleId Int
  role   Role @relation(fields: [roleId], references: [id])
  user   User @relation(fields: [userId], references: [id])

  @@id([userId, roleId])
}

model Client {
  id              Int                 @id @default(autoincrement())
  name            String
  email           String?             @unique
  phoneNumber     String?
  phone           String?
  birthday        DateTime?
  discoverySource String?
  loyaltyPoints   Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  appointments    Appointment[]
  attentions      Attention[]
  redemptions     LoyaltyRedemption[]
}

model LoyaltyRedemption {
  id        Int      @id @default(autoincrement())
  clientId  Int
  points    Int
  notes     String?
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id])
}

model ServiceCategory {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  services    Service[]
}

model Service {
  id           Int                  @id @default(autoincrement())
  name         String
  description  String?
  price        Decimal              @db.Decimal(10, 2)
  durationMin  Int
  isActive     Boolean              @default(true)
  categoryId   Int?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  appointments Appointment[]
  attentions   Attention[]
  quoteItems   CorporateQuoteItem[]
  category     ServiceCategory?     @relation(fields: [categoryId], references: [id])
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Appointment {
  id         Int                 @id @default(autoincrement())
  date       DateTime
  status     AppointmentStatus   @default(PENDING)
  notes      String?
  cost       Decimal             @default(0) @db.Decimal(10, 2)
  duration   Int                 @default(60)
  clientId   Int
  workerId   Int?
  serviceId  Int
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  client     Client              @relation(fields: [clientId], references: [id])
  service    Service             @relation(fields: [serviceId], references: [id])
  worker     User?               @relation("WorkerAppointments", fields: [workerId], references: [id])
  workers    AppointmentWorker[]
  attentions Attention[]
  payments   Payment[]
}

model AppointmentWorker {
  id            Int         @id @default(autoincrement())
  appointmentId Int
  workerId      Int
  isPrimary     Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  worker        User        @relation(fields: [workerId], references: [id])

  @@unique([appointmentId, workerId])
}

model Attention {
  id            Int               @id @default(autoincrement())
  date          DateTime          @default(now())
  notes         String?
  totalCost     Decimal           @db.Decimal(10, 2)
  clientId      Int
  serviceId     Int
  appointmentId Int?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  appointment   Appointment?      @relation(fields: [appointmentId], references: [id])
  client        Client            @relation(fields: [clientId], references: [id])
  service       Service           @relation(fields: [serviceId], references: [id])
  workers       AttentionWorker[]
  payments      Payment[]
}

model AttentionWorker {
  id               Int       @id @default(autoincrement())
  attentionId      Int
  workerId         Int
  commissionAmount Decimal   @default(0) @db.Decimal(10, 2)
  isPrimary        Boolean   @default(true)
  isPaid           Boolean   @default(false)
  paidAt           DateTime?
  expenseId        Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  attention        Attention @relation(fields: [attentionId], references: [id])
  worker           User      @relation(fields: [workerId], references: [id])

  @@unique([attentionId, workerId])
}

model Payment {
  id               Int             @id @default(autoincrement())
  amount           Decimal         @db.Decimal(10, 2)
  date             DateTime        @default(now())
  method           PaymentMethod   @default(CASH)
  type             PaymentType     @default(FULL)
  notes            String?
  appointmentId    Int?
  attentionId      Int?
  corporateEventId Int?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  appointment      Appointment?    @relation(fields: [appointmentId], references: [id])
  attention        Attention?      @relation(fields: [attentionId], references: [id])
  corporateEvent   CorporateEvent? @relation(fields: [corporateEventId], references: [id])
}

model Expense {
  id               Int             @id @default(autoincrement())
  description      String
  amount           Decimal         @db.Decimal(10, 2)
  date             DateTime        @default(now())
  category         String?
  typeId           Int?
  workerId         Int?
  corporateEventId Int?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  type             ExpenseType?    @relation(fields: [typeId], references: [id])
  worker           User?           @relation("WorkerExpenses", fields: [workerId], references: [id])
  corporateEvent   CorporateEvent? @relation(fields: [corporateEventId], references: [id])
}

model ExpenseType {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  expenses    Expense[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  entity    String
  entityId  Int?
  action    String
  oldData   Json?
  newData   Json?
  userId    Int?
  createdAt DateTime @default(now())
  user      User?    @relation("UserAuditLogs", fields: [userId], references: [id])
}

model NotificationTask {
  id                   Int                    @id @default(autoincrement())
  type                 NotificationTaskType
  executeAt            DateTime
  status               NotificationTaskStatus @default(PENDING)
  title                String
  body                 String
  data                 Json?
  targetUserId         Int
  relatedClientId      Int?
  relatedAppointmentId Int?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  targetUser           User                   @relation("UserNotificationTasks", fields: [targetUserId], references: [id])

  @@index([executeAt, status])
}

model Company {
  id           Int              @id @default(autoincrement())
  name         String
  ruc          String?
  contactName  String?
  contactPhone String?
  contactEmail String?
  address      String?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  quotes       CorporateQuote[]
  events       CorporateEvent[]
}

model CorporateQuote {
  id                 Int                  @id @default(autoincrement())
  code               String               @unique
  companyId          Int
  location           String?
  title              String
  subtitle           String?
  issueDate          DateTime
  validityDays       Int                  @default(7)
  status             CorporateQuoteStatus @default(DRAFT)
  introduction       String?
  serviceDescription String?
  focusZones         String[]             @default([])
  sessionDurationMin Int                  @default(15)
  therapistsCount    Int                  @default(1)
  chairsCount        Int                  @default(0)
  modality           String?
  scopeItems         String[]             @default([])
  conditions         Json?
  showIssuerRuc      Boolean              @default(false)
  includeIgv         Boolean              @default(false)
  igvIncluded        Boolean              @default(false)
  igvRate            Decimal              @default(18) @db.Decimal(5, 2)
  subtotal           Decimal              @default(0) @db.Decimal(10, 2)
  discount           Decimal              @default(0) @db.Decimal(10, 2)
  igvAmount          Decimal              @default(0) @db.Decimal(10, 2)
  total              Decimal              @default(0) @db.Decimal(10, 2)
  showBreakdown      Boolean              @default(false)
  therapistDayRate   Decimal              @default(0) @db.Decimal(10, 2)
  notes              String?
  createdById        Int?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  company            Company              @relation(fields: [companyId], references: [id])
  createdBy          User?                @relation("QuoteCreatedBy", fields: [createdById], references: [id])
  days               CorporateQuoteDay[]
  items              CorporateQuoteItem[]
  event              CorporateEvent?
}

model CorporateQuoteDay {
  id        Int            @id @default(autoincrement())
  quoteId   Int
  date      DateTime
  startTime String
  endTime   String
  quote     CorporateQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model CorporateQuoteItem {
  id          Int            @id @default(autoincrement())
  quoteId     Int
  serviceId   Int?
  description String
  quantity    Decimal        @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal        @db.Decimal(10, 2)
  subtotal    Decimal        @db.Decimal(10, 2)
  quote       CorporateQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  service     Service?       @relation(fields: [serviceId], references: [id])
}

model CorporateEvent {
  id                 Int                  @id @default(autoincrement())
  quoteId            Int?                 @unique
  companyId          Int
  title              String
  location           String?
  status             CorporateEventStatus @default(SCHEDULED)
  agreedAmount       Decimal              @db.Decimal(10, 2)
  sessionDurationMin Int                  @default(15)
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  quote              CorporateQuote?      @relation(fields: [quoteId], references: [id])
  company            Company              @relation(fields: [companyId], references: [id])
  days               CorporateEventDay[]
  payments           Payment[]
  expenses           Expense[]
}

model CorporateEventDay {
  id            Int                     @id @default(autoincrement())
  eventId       Int
  date          DateTime
  startTime     String
  endTime       String
  status        CorporateEventDayStatus @default(SCHEDULED)
  sessionsCount Int?
  notes         String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  event         CorporateEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  workers       CorporateEventWorker[]
}

model CorporateEventWorker {
  id         Int               @id @default(autoincrement())
  eventDayId Int
  workerId   Int
  payAmount  Decimal           @default(0) @db.Decimal(10, 2)
  isPaid     Boolean           @default(false)
  paidAt     DateTime?
  expenseId  Int?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  eventDay   CorporateEventDay @relation(fields: [eventDayId], references: [id], onDelete: Cascade)
  worker     User              @relation(fields: [workerId], references: [id])

  @@unique([eventDayId, workerId])
}

enum CorporateQuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  CONVERTED
}

enum CorporateEventStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CorporateEventDayStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentMethod {
  CASH
  CARD
  YAPE
  PLIN
  TRANSFER
}

enum PaymentType {
  ADVANCE
  FULL
  RELICIDATION
}

enum NotificationTaskType {
  BIRTHDAY_REMINDER
  UPCOMING_APPOINTMENT
  PENDING_ATTENTION_RECORD
}

enum NotificationTaskStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}
